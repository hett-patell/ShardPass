  "dependencies": {
    "@bufbuild/protobuf": "catalog:",
    "@noble/ciphers": "catalog:",
    "@noble/hashes": "catalog:",
    "@shardpass/crypto": "workspace:*",
    "@shardpass/domain": "workspace:*",
    "@shardpass/otp": "workspace:*",
    "@shardpass/security": "workspace:*",
    "@streamparser/json": "catalog:",
    "zod": "catalog:"
