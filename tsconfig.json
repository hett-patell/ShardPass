{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "eslint.config.js",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "playwright.config.ts",
    "prettier.config.js",
    "scripts/**/*.d.mts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tools/**/*.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
